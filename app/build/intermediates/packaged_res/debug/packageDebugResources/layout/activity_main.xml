<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEAT GUARD"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Charging temperature protection"
            android:textColor="#7F858F"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Battery temperature"
            android:textColor="#AEB3BC"
            android:textSize="15sp"
            android:layout_marginTop="48dp"/>


        <TextView
            android:id="@+id/currentTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--.- °C"
            android:textColor="#FFFFFF"
            android:textSize="58sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>


        <TextView
            android:id="@+id/chargingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checking charger..."
            android:textColor="#AEB3BC"
            android:textSize="15sp"
            android:layout_marginTop="5dp"/>


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alert temperature"
            android:textColor="#AEB3BC"
            android:textSize="15sp"
            android:layout_marginTop="44dp"/>


        <EditText
            android:id="@+id/thresholdInput"
            android:layout_width="150dp"
            android:layout_height="66dp"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:maxLength="4"
            android:text="42"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:selectAllOnFocus="true"
            android:background="@drawable/temperature_box"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/monitorButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="START MONITORING"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/button_primary"
            android:stateListAnimator="@null"
            android:layout_marginTop="34dp"/>


        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="ALLOW ALARM OVER OTHER APPS"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/button_secondary"
            android:stateListAnimator="@null"
            android:layout_marginTop="12dp"/>


        <TextView
            android:id="@+id/monitorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoring is OFF"
            android:textColor="#FF5A52"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="27dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heat Guard watches battery temperature while your phone is connected to power. If the selected temperature is reached, the alarm continues until you tap the warning or unplug the charger."
            android:textColor="#7F858F"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="28dp"/>

    </LinearLayout>

</ScrollView>
