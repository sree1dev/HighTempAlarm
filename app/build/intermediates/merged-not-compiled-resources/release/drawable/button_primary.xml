<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape android:shape="rectangle">

            <solid android:color="#E54842"/>

            <corners android:radius="20dp"/>

            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp"/>

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#FF5A52"/>

            <corners android:radius="20dp"/>

            <padding
                android:left="18dp"
                android:top="14dp"
                android:right="18dp"
                android:bottom="14dp"/>

        </shape>

    </item>

</selector>
