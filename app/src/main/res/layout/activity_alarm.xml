<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#B71C1C"
    android:padding="28dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BATTERY TOO HOT"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:id="@+id/alarmTemperature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--.- °C"
        android:textColor="#FFFFFF"
        android:textSize="64sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"/>

    <TextView
        android:id="@+id/alarmThreshold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limit: -- °C"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="5dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UNPLUG THE CHARGER"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:layout_marginTop="45dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap anywhere to stop alarm"
        android:textColor="#EFCACA"
        android:textSize="14sp"
        android:layout_marginTop="14dp"/>

    <Button
        android:id="@+id/stopAlarmButton"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:text="STOP ALARM"
        android:textColor="#B71C1C"
        android:textSize="18sp"
        android:textStyle="bold"
        android:background="@drawable/button_secondary"
        android:stateListAnimator="@null"
        android:layout_marginTop="35dp"/>

</LinearLayout>
